# syntax=docker/dockerfile:1.7

FROM node:26-bookworm-slim

ARG CAMOFOX_VERSION=1.14.0

# Pinned Camoufox browser build, expressed as the version string camoufox-js'
# resolver writes to version.json (installedVerStr()): "<firefox>-<release>".
# The browser is installed using camoufox-js' resolver layout in INSTALL_DIR
# (default ~/.cache/camoufox). We download the exact GitHub release archive,
# verify its SHA-256, extract with CamoufoxFetcher.extractZip(), then write the
# resolver's version.json and validate installedVerStr()/launchPath().
ARG CAMOUFOX_BROWSER_VERSION=152.0.4-beta.30
ARG CAMOUFOX_BROWSER_URL=https://github.com/daijro/camoufox/releases/download/v152.0.4-beta.30/camoufox-152.0.4-beta.30-lin.x86_64.zip
ARG CAMOUFOX_BROWSER_SHA256=5720d45b894ce1770543de024c6f10d514b38be560fa2dc3226b3d8586caf672
ARG CAMOUFOX_BROWSER_ASSET_ID=538708879

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    NODE_OPTIONS=--max-old-space-size=256 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    CAMOFOX_HOST=0.0.0.0 \
    CAMOFOX_PORT=9377

# Firefox/Camoufox runtime dependencies.
#
# Mesa and Xvfb are important here:
# - Mesa supplies software-rendered WebGL.
# - Xvfb lets Camoufox run in headed mode inside the container.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        libgtk-3-0 \
        libdbus-glib-1-2 \
        libxt6 \
        libasound2 \
        libx11-xcb1 \
        libxcomposite1 \
        libxcursor1 \
        libxdamage1 \
        libxfixes3 \
        libxi6 \
        libxrandr2 \
        libxrender1 \
        libxss1 \
        libxtst6 \
        libegl1-mesa \
        libgl1-mesa-dri \
        libgbm1 \
        xvfb \
        fonts-liberation \
        fonts-noto-color-emoji \
        fontconfig \
        ca-certificates \
        curl \
        unzip \
        python3 \
        make \
        g++ \
    && rm -rf /var/lib/apt/lists/*

# Install the complete Camofox runtime from a lockfile. The lock pins the
# server package and the Camoufox/Playwright versions used by the upstream 1.14
# release.
WORKDIR /opt/camofox
COPY docker/camofox/package.json docker/camofox/package-lock.json ./
RUN npm config set registry https://registry.npmjs.org/ \
    && CAMOFOX_SKIP_DOWNLOAD=1 npm ci --omit=dev --no-audit --no-fund \
    && test "$(node -p "require('./node_modules/@askjo/camofox-browser/package.json').version")" = "${CAMOFOX_VERSION}" \
    && test "$(node -p "require('./node_modules/playwright-core/package.json').version")" = "1.63.0" \
    && test "$(node -p "require('./node_modules/camoufox-js/package.json').version")" = "0.11.5" \
    && mkdir -p /usr/local/lib/node_modules/@askjo \
    && ln -s /opt/camofox/node_modules/@askjo/camofox-browser /usr/local/lib/node_modules/@askjo/camofox-browser \
    && ln -s /opt/camofox/node_modules/@askjo/camofox-browser/bin/camofox-browser.js /usr/local/bin/camofox-browser \
    && npm cache clean --force

# better-sqlite3 is compiled during npm ci; compilers and Python are not
# needed by the resulting runtime module.
RUN apt-get purge --yes --auto-remove g++ make python3 \
    && rm -rf /var/lib/apt/lists/*

# Validate the shipped upstream module instead of patching it. v1.14.0 already
# contains the viewport:null test context and the reporter reset hook.
RUN set -eux; \
    CAMOFOX_DIR="$(npm root --global)/@askjo/camofox-browser"; \
    CAMOFOX_REAL_DIR="$(readlink -f "${CAMOFOX_DIR}")"; \
    SERVER_FILE="${CAMOFOX_REAL_DIR}/server.js"; \
    REPORTER_FILE="${CAMOFOX_REAL_DIR}/lib/reporter.js"; \
    test -f "${SERVER_FILE}"; \
    test -f "${REPORTER_FILE}"; \
    grep -Fq 'testContext = await browser.newContext({ viewport: null });' "${SERVER_FILE}"; \
    grep -Fq 'resetNativeMemBaseline: () => {}' "${REPORTER_FILE}"; \
    grep -Fq 'resetNativeMemBaseline,' "${REPORTER_FILE}"; \
    node --check "${SERVER_FILE}"

# Install the pinned Camoufox archive using the same resolver layout as
# camoufox-js. The asset is checked before extraction and the version file is
# written exactly as the resolver would.
RUN set -eux; \
    curl -fsSLo /tmp/camoufox.zip "${CAMOUFOX_BROWSER_URL}"; \
    echo "${CAMOUFOX_BROWSER_SHA256}  /tmp/camoufox.zip" | sha256sum --check --status; \
    node --input-type=module -e "import fs from 'node:fs'; import path from 'node:path'; import { execFileSync } from 'node:child_process'; import { CamoufoxFetcher, INSTALL_DIR, installedVerStr, launchPath } from 'camoufox-js/dist/pkgman.js'; const expected = '${CAMOUFOX_BROWSER_VERSION}'; const fetcher = new CamoufoxFetcher(); if (fetcher.arch !== 'x86_64') { throw new Error('Unsupported Camoufox architecture ' + fetcher.arch + '; expected x86_64.'); } CamoufoxFetcher.cleanup(); fs.mkdirSync(INSTALL_DIR, { recursive: true }); await fetcher.extractZip('/tmp/camoufox.zip'); fs.writeFileSync(path.join(INSTALL_DIR.toString(), 'version.json'), JSON.stringify({ version: '152.0.4', release: 'beta.30' })); if (process.platform !== 'win32') { execFileSync('chmod', ['-R', '755', INSTALL_DIR.toString()]); } const actual = installedVerStr(); if (actual !== expected) { throw new Error('Camoufox version drift: expected ' + expected + ' but installed ' + actual + '.'); } const executable = launchPath(); if (!fs.existsSync(executable)) { throw new Error('Camoufox executable missing at ' + executable + '.'); } console.log('Camoufox ' + actual + ' installed at ' + executable + ' (asset 538708879)');" \
    && rm -f /tmp/camoufox.zip
# Preload the GeoIP database and the default UBO addon into the same resolver
# cache layout the upstream launcher reads at runtime. This preserves the
# isolated runtime network while preventing launch-time fetches.
RUN set -eux; \
    node --input-type=module -e "import fs from 'node:fs'; import path from 'node:path'; import { execFileSync } from 'node:child_process'; import { INSTALL_DIR, CamoufoxFetcher, installedVerStr, launchPath } from 'camoufox-js/dist/pkgman.js'; import { downloadMMDB } from 'camoufox-js/dist/locale.js'; import { addDefaultAddons } from 'camoufox-js/dist/addons.js'; const fetcher = new CamoufoxFetcher(); if (fetcher.arch !== 'x86_64') { throw new Error('Unsupported Camoufox architecture ' + fetcher.arch + '; expected x86_64.'); } await downloadMMDB(); await addDefaultAddons([], []); const mmdb = path.join(INSTALL_DIR.toString(), 'GeoLite2-City.mmdb'); const addonManifest = path.join(INSTALL_DIR.toString(), 'addons', 'UBO', 'manifest.json'); if (!fs.existsSync(mmdb)) { throw new Error('GeoIP database missing at ' + mmdb + '.'); } if (!fs.existsSync(addonManifest)) { throw new Error('UBO addon missing at ' + addonManifest + '.'); } if (process.platform !== 'win32') { execFileSync('chmod', ['-R', '755', INSTALL_DIR.toString()]); } const expected = '${CAMOUFOX_BROWSER_VERSION}'; const actual = installedVerStr(); if (actual !== expected) { throw new Error('Camoufox version drift: expected ' + expected + ' but installed ' + actual + '.'); } const executable = launchPath(); if (!fs.existsSync(executable)) { throw new Error('Camoufox executable missing at ' + executable + '.'); } console.log('Preloaded GeoIP and UBO for Camoufox ' + actual + ' at ' + INSTALL_DIR.toString());"

EXPOSE 9377

HEALTHCHECK \
    --interval=15s \
    --timeout=5s \
    --start-period=45s \
    --retries=10 \
    CMD curl --fail --silent --show-error \
        http://127.0.0.1:9377/health \
        >/dev/null || exit 1

CMD ["camofox-browser"]